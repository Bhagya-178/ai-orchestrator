# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=0

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_orchestrator

# Initial Administrative User (Set before first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here

# Phase 3 - RAG
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
EMBEDDING_MODEL=bge-m3:latest

# Models
PROCESSOR_MODEL=qwen2.5:1.5b
SUMMARY_MODEL=qwen2.5:1.5b

# Optional: Real Email Delivery via SMTP (e.g. Gmail)
# If left empty, Dev OTP will be displayed in the UI and logged to the terminal
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="AI Orchestrator"
SMTP_TLS=true

# OTP Verification Policies
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5